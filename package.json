{
  "name": "operumdata-afiliados",
  "version": "1.0.0",
  "description": "Plataforma de afiliados OperumData. Desenvolvimento e homologação isolados; produção somente com aprovação expressa.",
  "main": "index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "check": "node --check src/app.js && node --check public/app.js && node --check public/demo.js && node --check public/js/landing.js && node --check tools/preview-frontend.js && node --check tools/export-frontend.js && node tools/check-commercial.js",
    "test": "node --test",
    "preview:frontend": "node tools/preview-frontend.js",
    "check:edge": "deno check supabase/functions/partner-apply/index.ts supabase/functions/commercial-api/index.ts supabase/functions/manage-partners/index.ts supabase/functions/staff-invite/index.ts",
    "build:commercial": "node tools/build-commercial-client.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wdccruz/operumdata-afiliados.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "bugs": {
    "url": "https://github.com/wdccruz/operumdata-afiliados/issues"
  },
  "homepage": "https://github.com/wdccruz/operumdata-afiliados#readme",
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "deno": "2.9.6",
    "esbuild": "0.28.2",
    "supabase": "3.1.0"
  }
}
